{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Proxy RS",
  "version": "1.0.0",
  "identifier": "dev.proxyrs.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Proxy RS · SOCKS5 代理",
        "width": 980,
        "height": 720,
        "minWidth": 860,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Proxy RS",
    "copyright": "Copyright © 2026 Proxy RS",
    "shortDescription": "轻量无认证 SOCKS5 桌面代理",
    "longDescription": "按网卡与端口一键启动无认证 SOCKS5 代理，支持 TCP CONNECT 与 UDP ASSOCIATE。",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "Proxy RS"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
